  "clarification_schema": {
    "missing_gift_product": {
      "condition": "feature == free_gift AND reward.gift_product is unspecified or vague",
      "question_template": "Which product should the customer receive as the free gift?",
      "options_source": "product_taxonomy.Gift Items.products",
      "fallback_message": "If none fit, the admin can select any product from the store.",
      "example_question": "Did you mean one of these: Sample Gift, Mini Sample Pack, Mystery Gift Box, Welcome Gift?"
    },
    "ambiguous_trigger_product": {
      "condition": "trigger.type is product_quantity or product_subtotal AND product name matches >1 product",
      "question_template": "Which product should trigger this promotion?",
      "options_source": "product_taxonomy.{matched_category}.products",
      "example_question": "You mentioned 'shirt' — did you mean: Shirt, Premium T-Shirt, or Polo Shirt?"
    },
    "ambiguous_trigger_collection": {
      "condition": "trigger scope mentions a word that matches multiple collections",
      "question_template": "Which collection should trigger this promotion?",
      "options_source": "collection_product_index",
      "example_question": "Did you mean the Skincare collection or the Accessories collection?"
    },
    "missing_trigger_value": {
      "condition": "trigger.value is null — merchant did not specify a threshold",
      "question_template": "What is the minimum {trigger_type_label} to qualify for this promotion?",
      "examples": {
        "cart_subtotal":        "e.g. 'Spend $50', 'Spend $100', 'Orders over $200'",
        "cart_quantity":        "e.g. 'Buy 2 items', 'Buy 3 products'",
        "collection_quantity":  "e.g. 'Buy 2 items from Skincare'",
        "product_quantity":     "e.g. 'Buy 2 Shirts'"
      }
    },
    "ambiguous_y_target": {
      "condition": "buy_x_get_y AND reward.y_target is vague or matches multiple products",
      "question_template": "Which product or collection should receive the discount?",
      "options_source": "product_taxonomy.{merchant_mentioned_category}.products",
      "example_question": "You mentioned 'cap' — did you mean Cap or Snapback Cap?"
    },
    "missing_customer_tag": {
      "condition": "merchant used eligibility language but no tag specified",
      "question_template": "Which customer group should qualify for this promotion?",
      "options_source": "customer_tag_catalog",
      "example_question": "Should this apply to: VIP, Wholesale, Gold, Loyalty Member, or all customers?"
    },
    "missing_market": {
      "condition": "market eligibility needed but country/region not specified or ambiguous",
      "question_template": "Which market or country should this promotion apply to?",
      "options_source": "market_catalog",
      "example_question": "Should this run in India, United States, or all markets?"
    },
    "missing_reward_value": {
      "condition": "reward type is percentage_off or fixed_amount_off AND value is null",
      "question_template": "What discount should the customer receive?",
      "examples": {
        "percentage_off":   "e.g. '10% off', '20% off', '50% off'",
        "fixed_amount_off": "e.g. '$10 off', '$25 off', '500 off'"
      }
    },
    "ambiguous_tier_count": {
      "condition": "feature is tiered_discount AND only 1 tier found",
      "question_template": "Tiered discounts need at least 2 thresholds. What is the second tier?",
      "example_question": "You mentioned 'Buy 2 get 10% off' — what should customers get when they buy 4?"
    }
  }
}
